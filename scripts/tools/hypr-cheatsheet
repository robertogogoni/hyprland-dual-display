#!/usr/bin/env bash
# Hyprland keybinding cheat sheet — SUPER+F1

R='\033[0m'        D='\033[2m'
H='\033[1;36m'     K='\033[1;33m'     S='\033[38;5;240m'
P='\033[38;5;213m' O='\033[38;5;216m' G='\033[38;5;151m'
B='\033[38;5;111m' M='\033[38;5;183m'

clear; echo ""

hdr() { echo -e "  ${H}$1${R}"; echo -e "  ${S}$(printf '%.0s─' $(seq 1 46))${R}"; }
key() { printf "  ${K}%-30s${R} %s\n" "$1" "$2"; }

hdr "WORKSPACES (smart auto-sort)"
echo -e "  ${D}Laptop${R}  ${P}L1${R}=Dev ${O}L2${R}=Chat ${G}L3${R}=Work ${B}L4${R}=Game ${M}L5${R}=Sys"
echo -e "  ${D}TV${R}      ${P}T1${R}=Web ${O}T2${R}=Media ${G}T3${R}=Ref ${B}T4${R}=File ${M}T5${R}=Extra"
echo ""
key "Super + 1-5" "Switch workspace"
key "Super + Shift + 1-5" "Move window to workspace"
key "Super + Tab / Shift+Tab" "Next / previous"
key "Super + Ctrl + Tab" "Last visited"
key "Super + Shift + F1" "Reorganize all windows"
echo ""

hdr "WINDOWS"
key "Super + Arrows" "Move focus"
key "Super + Shift + Arrows" "Swap positions"
key "Super + J" "Toggle split direction"
key "Super + T" "Toggle floating"
key "Super + F" "Fullscreen"
key "Super + W" "Close window"
key "Super + O" "Pop out (float + pin)"
key "Super + - / =" "Resize"
key "Alt + Tab" "Cycle windows"
echo ""

hdr "SCRATCHPADS"
key "Super + A" "Dropdown terminal"
key "Super + Ctrl + B" "System monitor"
key "Super + Ctrl + E" "File explorer"
key "Super + Ctrl + M" "Music player"
key "Super + Ctrl + N" "Quick notes"
echo ""

hdr "FOCUS & ZEN"
key "Super + F2" "Focus mode (disable 2nd monitor)"
key "Super + F3" "Zen mode (zero-chrome + blank)"
key "Super + Z" "Toggle 2x zoom"
echo ""

hdr "TOOLS"
key "Super + V" "Clipboard history"
key "Print" "Screenshot (omarchy)"
key "Shift + Print" "Screenshot + annotate"
key "Super + Ctrl + S" "Swap monitors"
key "Super + /" "Cycle scaling"
echo -e "  ${D}Pomodoro: click timer icon in waybar${R}"
echo ""

hdr "LAUNCH"
key "Super + Enter" "Terminal"
key "Super + Shift + Enter" "Browser"
key "Super + Shift + F" "File manager"
key "Super + Shift + N" "Editor"
key "Super + Shift + O" "Obsidian"
key "Super + Shift + /" "Passwords"
echo ""

echo -e "  ${D}Press any key to close${R}"; echo ""
read -rsn1
