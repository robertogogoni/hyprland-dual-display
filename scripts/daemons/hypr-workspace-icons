#!/usr/bin/env python3
"""Workspace icon renamer for Hyprland + split-monitor-workspaces.

Sets workspace names to clean icons for waybar display:
  - Empty workspace: just the display number (e.g. "3")
  - Occupied workspace: icon(s) only (e.g. " 󰍡")
  - Position in the bar already conveys workspace number

Usage: hypr-workspace-icons  (runs as daemon)
"""

import json
import os
import signal
import socket
import subprocess
from pathlib import Path

PIDFILE = Path(f"/run/user/{os.getuid()}/hypr-workspace-icons.pid")

# App class → Nerd Font icon mapping
