#!/usr/bin/env python3
"""Workspace activity pulse — flashes waybar workspace buttons when windows update.

Listens for urgent window events and title changes on inactive workspaces,
then briefly sets the workspace to "urgent" via hyprctl so waybar highlights it.

Usage: hypr-activity-pulse  (runs as daemon)
"""

import json
import os
import socket
import subprocess
import sys
import threading
import time


def get_active_workspace():
    result = subprocess.run(
        ["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True
    )
    if result.returncode == 0:
        return json.loads(result.stdout).get("id", 0)
    return 0


def get_client_workspace(address):
    """Get workspace ID for a window by address."""
    result = subprocess.run(
        ["hyprctl", "clients", "-j"], capture_output=True, text=True
    )
    if result.returncode != 0:
        return 0
    addr_clean = address.replace("0x", "")
    for c in json.loads(result.stdout):
        if c.get("address", "").replace("0x", "") == addr_clean:
            return c.get("workspace", {}).get("id", 0)
    return 0


def pulse_workspace(ws_id):
    """Flash a workspace button by briefly setting urgent hint.

    Waybar shows .urgent class on the button, then we clear it.
    We do this by setting and unsetting a workspace rule.
    """
    # Use hyprctl to set workspace as having urgent window
    # The simplest approach: create a notification-like flash via workspace rename
    # Save current name, rename with a marker, rename back

    # Get current name
    result = subprocess.run(
        ["hyprctl", "workspaces", "-j"], capture_output=True, text=True
    )
    if result.returncode != 0:
        return

    current_name = None
    for ws in json.loads(result.stdout):
        if ws["id"] == ws_id:
            current_name = ws["name"]
            break

    if current_name is None:
        return

    # Flash: rename with a pulse marker, then restore
    # Use the actual workspace ID to avoid format-icons name collision
    subprocess.run(
        ["hyprctl", "dispatch", "renameworkspace", f"{ws_id} {ws_id}*"],
        capture_output=True,
    )
    time.sleep(1.5)
    subprocess.run(
        ["hyprctl", "dispatch", "renameworkspace", f"{ws_id} {ws_id}"],
        capture_output=True,
    )


def listen_events():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not sig:
        hypr_dir = f"/run/user/{os.getuid()}/hypr/"
        if os.path.isdir(hypr_dir):
            sigs = os.listdir(hypr_dir)
            if sigs:
                sig = sigs[0]
    if not sig:
        print("ERROR: Cannot find Hyprland instance", file=sys.stderr)
        sys.exit(1)

    socket_path = f"/run/user/{os.getuid()}/hypr/{sig}/.socket2.sock"
    print(f"Activity pulse daemon started (PID {os.getpid()})")

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(socket_path)

    # Track recent pulses to avoid spam
    last_pulse = {}
    COOLDOWN = 5  # seconds between pulses per workspace

    # Events that indicate activity
    activity_events = {"windowtitle", "urgent"}

    buf = b""
    while True:
        data = sock.recv(4096)
        if not data:
            break
        buf += data
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            decoded = line.decode("utf-8", errors="replace")
            parts = decoded.split(">>", 1)
            event = parts[0]

            if event not in activity_events:
                continue

            event_data = parts[1] if len(parts) > 1 else ""
            active_ws = get_active_workspace()

            # For windowtitle events, the data is the address
            address = event_data.split(",")[0]
            ws_id = get_client_workspace(address)

            if ws_id <= 0 or ws_id == active_ws:
                continue

            now = time.time()
            if now - last_pulse.get(ws_id, 0) < COOLDOWN:
                continue

            last_pulse[ws_id] = now
            threading.Thread(target=pulse_workspace, args=(ws_id,), daemon=True).start()


def ensure_single_instance():
    import signal
    from pathlib import Path
    pidfile = Path("/tmp/hypr-activity-pulse.pid")
    if pidfile.exists():
        try:
            os.kill(int(pidfile.read_text().strip()), signal.SIGTERM)
        except (ProcessLookupError, ValueError):
            pass
    pidfile.write_text(str(os.getpid()))


if __name__ == "__main__":
    from pathlib import Path as _Path
    ensure_single_instance()
    try:
        listen_events()
    except KeyboardInterrupt:
        print("\nActivity pulse daemon stopped.")
    finally:
        _Path("/tmp/hypr-activity-pulse.pid").unlink(missing_ok=True)
